# =============================================================================
# hw-large — AWS c5.24xlarge (96 vCPU / 192 GB RAM / NVMe RAID0)
# Docker budget: ~96 CPU / ~152 GB RAM
# Use: ./infra/scripts/deploy.sh --profile prod --target aws --hw large
# =============================================================================

# ── Concurrency ───────────────────────────────────────────────────────────────
# 97 Gunicorn workers × (12+12) pool = 2328 max Postgres connections
# ANYIO_MIN_THREADS=24 allows more concurrent cache-hit handlers per worker.
# REDIS_MAX_CONNECTIONS=2500 = anyio_total(2328) × 1.1 with headroom.
BACKEND_WEB_CONCURRENCY=24
WORKER_CONCURRENCY=12
DB_POOL_SIZE=4
DB_MAX_OVERFLOW=3
DB_POOL_TIMEOUT=30
REDIS_MAX_CONNECTIONS=2500
LOG_LEVEL=WARNING
ANYIO_MIN_THREADS=24
BACKEND_GUNICORN_MAX_REQUESTS=2000
BACKEND_GUNICORN_MAX_REQUESTS_JITTER=200
VIDEO_DETAIL_CACHE_TTL=60

# ── PostgreSQL tuning (container: 24 CPU / 64 GB) ────────────────────────────
POSTGRES_MAX_CONNECTIONS=2500
POSTGRES_SHARED_BUFFERS=16GB
POSTGRES_EFFECTIVE_CACHE_SIZE=48GB
POSTGRES_WORK_MEM=16MB
POSTGRES_MAINTENANCE_WORK_MEM=2GB
POSTGRES_SHM_SIZE=20g

# ── Redis (container: 4 CPU / 18 GB) ─────────────────────────────────────────
REDIS_MAXMEMORY=16gb

# ── Container resource limits ─────────────────────────────────────────────────
# Total: 96 CPU / 152 GB RAM
NGINX_CPU_LIMIT=4.00
NGINX_MEMORY_LIMIT=2G
NGINX_CPU_RESERVATION=1.00
NGINX_MEMORY_RESERVATION=512M

POSTGRES_CPU_LIMIT=24.00
POSTGRES_MEMORY_LIMIT=64G
POSTGRES_CPU_RESERVATION=4.00
POSTGRES_MEMORY_RESERVATION=2G

REDIS_CPU_LIMIT=4.00
REDIS_MEMORY_LIMIT=18G
REDIS_CPU_RESERVATION=1.00
REDIS_MEMORY_RESERVATION=512M

BACKEND_CPU_LIMIT=48.00
BACKEND_MEMORY_LIMIT=48G
BACKEND_CPU_RESERVATION=4.00
BACKEND_MEMORY_RESERVATION=2G

WORKER_CPU_LIMIT=12.00
WORKER_MEMORY_LIMIT=16G
WORKER_CPU_RESERVATION=2.00
WORKER_MEMORY_RESERVATION=1G

FRONTEND_CPU_LIMIT=4.00
FRONTEND_MEMORY_LIMIT=4G
FRONTEND_CPU_RESERVATION=0.25
FRONTEND_MEMORY_RESERVATION=128M
BACKEND_REPLICAS=4

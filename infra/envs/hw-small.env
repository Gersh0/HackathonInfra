# =============================================================================
# hw-small — Workstation / gaming PC (4-8 cores / 8-16 GB RAM)
# Docker budget: ~8.5 CPU / ~6 GB RAM
# Use: ./infra/scripts/deploy.sh --profile prod --target local --hw small
# AWS equivalent: t3.xlarge / c5.xlarge (4 vCPU / 8-16 GB)
# =============================================================================

# ── Concurrency ───────────────────────────────────────────────────────────────
# 4 Gunicorn workers × (8+12) pool = 80 max Postgres connections
# ANYIO_MIN_THREADS=20 decouples thread limit from DB pool — cache-hit routes
# don't consume DB connections so extra threads cost only Redis connections.
# REDIS_MAX_CONNECTIONS=200 = anyio_total(80) × 2 ops/request with headroom.
BACKEND_WEB_CONCURRENCY=4
WORKER_CONCURRENCY=2
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
DB_POOL_TIMEOUT=30
REDIS_MAX_CONNECTIONS=200
LOG_LEVEL=WARNING
ANYIO_MIN_THREADS=20
BACKEND_GUNICORN_MAX_REQUESTS=2000
BACKEND_GUNICORN_MAX_REQUESTS_JITTER=200
VIDEO_DETAIL_CACHE_TTL=60

# ── PostgreSQL tuning ─────────────────────────────────────────────────────────
POSTGRES_MAX_CONNECTIONS=100
POSTGRES_SHARED_BUFFERS=512MB
POSTGRES_EFFECTIVE_CACHE_SIZE=1536MB
POSTGRES_WORK_MEM=8MB
POSTGRES_MAINTENANCE_WORK_MEM=128MB
POSTGRES_SHM_SIZE=1g

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_MAXMEMORY=512mb

# ── Container resource limits ─────────────────────────────────────────────────
# Total: ~8.5 CPU / ~6 GB RAM
NGINX_MEMORY_LIMIT=512M
NGINX_MEMORY_RESERVATION=256M
BACKEND_MEMORY_LIMIT=1G
BACKEND_MEMORY_RESERVATION=256M

POSTGRES_CPU_LIMIT=2.00
POSTGRES_MEMORY_LIMIT=2G
POSTGRES_CPU_RESERVATION=1.00
POSTGRES_MEMORY_RESERVATION=512M

REDIS_CPU_LIMIT=1.00
REDIS_MEMORY_LIMIT=768M
REDIS_CPU_RESERVATION=0.50
REDIS_MEMORY_RESERVATION=256M

BACKEND_CPU_LIMIT=3.00
BACKEND_MEMORY_LIMIT=2G
BACKEND_CPU_RESERVATION=1.00
BACKEND_MEMORY_RESERVATION=512M

WORKER_CPU_LIMIT=1.00
WORKER_MEMORY_LIMIT=768M
WORKER_CPU_RESERVATION=0.50
WORKER_MEMORY_RESERVATION=256M

FRONTEND_CPU_LIMIT=0.50
FRONTEND_MEMORY_LIMIT=256M
FRONTEND_CPU_RESERVATION=0.25
FRONTEND_MEMORY_RESERVATION=128M
BACKEND_REPLICAS=2

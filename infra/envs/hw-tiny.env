# =============================================================================
# hw-tiny — Development laptop (2-4 cores / 4-8 GB RAM)
# Docker budget: ~4 CPU / ~2 GB RAM
# Use: ./infra/scripts/deploy.sh --profile dev --target local --hw tiny
# =============================================================================

# ── Concurrency ───────────────────────────────────────────────────────────────
# 2 Gunicorn workers × (2+2) pool = 4 max Postgres connections
BACKEND_WEB_CONCURRENCY=2
WORKER_CONCURRENCY=1
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=3
DB_POOL_TIMEOUT=3
REDIS_MAX_CONNECTIONS=40
LOG_LEVEL=WARNING
ANYIO_MIN_THREADS=6
BACKEND_GUNICORN_MAX_REQUESTS=2000
BACKEND_GUNICORN_MAX_REQUESTS_JITTER=200
VIDEO_DETAIL_CACHE_TTL=30

# ── PostgreSQL tuning ─────────────────────────────────────────────────────────
POSTGRES_MAX_CONNECTIONS=50
POSTGRES_SHARED_BUFFERS=128MB
POSTGRES_EFFECTIVE_CACHE_SIZE=384MB
POSTGRES_WORK_MEM=4MB
POSTGRES_MAINTENANCE_WORK_MEM=32MB
POSTGRES_SHM_SIZE=256m

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_MAXMEMORY=128mb

# ── Container resource limits ────────────────────────────────────────────────
# Total: ~4.25 CPU / ~2.05 GB RAM
NGINX_CPU_LIMIT=0.50
NGINX_MEMORY_LIMIT=128M
NGINX_CPU_RESERVATION=0.25
NGINX_MEMORY_RESERVATION=64M

POSTGRES_CPU_LIMIT=1.00
POSTGRES_MEMORY_LIMIT=512M
POSTGRES_CPU_RESERVATION=0.50
POSTGRES_MEMORY_RESERVATION=256M

REDIS_CPU_LIMIT=0.50
REDIS_MEMORY_LIMIT=256M
REDIS_CPU_RESERVATION=0.25
REDIS_MEMORY_RESERVATION=128M

BACKEND_CPU_LIMIT=1.50
BACKEND_MEMORY_LIMIT=768M
BACKEND_CPU_RESERVATION=0.50
BACKEND_MEMORY_RESERVATION=256M

WORKER_CPU_LIMIT=0.50
WORKER_MEMORY_LIMIT=256M
WORKER_CPU_RESERVATION=0.25
WORKER_MEMORY_RESERVATION=128M

FRONTEND_CPU_LIMIT=0.25
FRONTEND_MEMORY_LIMIT=128M
FRONTEND_CPU_RESERVATION=0.10
FRONTEND_MEMORY_RESERVATION=64M

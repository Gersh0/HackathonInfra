# =============================================================================
# hw-medium — Dedicated server (8-32 cores / 32-64 GB RAM)
# Docker budget: ~27 CPU / ~27 GB RAM
# Use: ./infra/scripts/deploy.sh --profile prod --target local --hw medium
# AWS equivalent: c5.4xlarge (16 vCPU / 32 GB) or c5.9xlarge (36 vCPU / 72 GB)
# =============================================================================

# ── Concurrency ───────────────────────────────────────────────────────────────
# 16 Gunicorn workers × (8+12) pool = 320 max Postgres connections
# ANYIO_MIN_THREADS=20 allows more concurrent cache-hit handlers per worker.
# REDIS_MAX_CONNECTIONS=500 = anyio_total(320) × 1.5 with headroom.
BACKEND_WEB_CONCURRENCY=16
WORKER_CONCURRENCY=8
DB_POOL_SIZE=8
DB_MAX_OVERFLOW=12
DB_POOL_TIMEOUT=3
REDIS_MAX_CONNECTIONS=500
LOG_LEVEL=WARNING
ANYIO_MIN_THREADS=20
BACKEND_GUNICORN_MAX_REQUESTS=2000
BACKEND_GUNICORN_MAX_REQUESTS_JITTER=200
VIDEO_DETAIL_CACHE_TTL=60

# ── PostgreSQL tuning ─────────────────────────────────────────────────────────
POSTGRES_MAX_CONNECTIONS=400
POSTGRES_SHARED_BUFFERS=2GB
POSTGRES_EFFECTIVE_CACHE_SIZE=6GB
POSTGRES_WORK_MEM=16MB
POSTGRES_MAINTENANCE_WORK_MEM=512MB
POSTGRES_SHM_SIZE=4g

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_MAXMEMORY=4gb

# ── Container resource limits ─────────────────────────────────────────────────
# Total: ~27 CPU / ~27 GB RAM
NGINX_CPU_LIMIT=2.00
NGINX_MEMORY_LIMIT=512M
NGINX_CPU_RESERVATION=1.00
NGINX_MEMORY_RESERVATION=256M

POSTGRES_CPU_LIMIT=6.00
POSTGRES_MEMORY_LIMIT=8G
POSTGRES_CPU_RESERVATION=2.00
POSTGRES_MEMORY_RESERVATION=2G

REDIS_CPU_LIMIT=2.00
REDIS_MEMORY_LIMIT=6G
REDIS_CPU_RESERVATION=1.00
REDIS_MEMORY_RESERVATION=1G

BACKEND_CPU_LIMIT=12.00
BACKEND_MEMORY_LIMIT=8G
BACKEND_CPU_RESERVATION=4.00
BACKEND_MEMORY_RESERVATION=2G

WORKER_CPU_LIMIT=4.00
WORKER_MEMORY_LIMIT=4G
WORKER_CPU_RESERVATION=2.00
WORKER_MEMORY_RESERVATION=1G

FRONTEND_CPU_LIMIT=1.00
FRONTEND_MEMORY_LIMIT=512M
FRONTEND_CPU_RESERVATION=0.25
FRONTEND_MEMORY_RESERVATION=128M

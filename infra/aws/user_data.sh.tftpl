#!/usr/bin/env bash
# =============================================================================
# user_data.sh.tftpl — Script de arranque de la EC2 (bootstrap)
# =============================================================================
# Archivo TEMPLATE de Terraform (.tftpl). Las expresiones $${...} son
# reemplazadas por Terraform ANTES de enviar el script a AWS. La EC2
# lo ejecuta UNA SOLA VEZ como root en el primer arranque.
#
# Orden de operaciones:
#   1. Paquetes base (apt)
#   2. NVMe local storage → RAID0 → /data  (c5d tiene 4×900 GB NVMe)
#   3. Instalación de Docker con data-root en /data/docker (si hay NVMe)
#   4. Tuning del kernel (sysctl, ulimits)
#   5. Clon del repositorio
#   6. Escritura del .env con todos los parámetros de Terraform
#   7. docker compose --profile prod up -d
#
# Log de esta ejecución: /var/log/youtube-clone-provision.log
# =============================================================================
set -euo pipefail

exec > >(tee -a /var/log/youtube-clone-provision.log) 2>&1

echo "=== bootstrap started at $(date -u) ==="

export DEBIAN_FRONTEND=noninteractive

# ── 1. Paquetes base ──────────────────────────────────────────────────────────
apt-get update
apt-get install -y ca-certificates curl git gnupg mdadm xfsprogs

# ── 2. NVMe local instance storage (c5d: 4×900 GB) ───────────────────────────
# Detectar todos los discos NVMe que NO son el volumen raíz (EBS).
# En c5d.24xlarge: /dev/nvme0n1 = raíz EBS, nvme1n1-nvme4n1 = NVMe locales.
ROOT_DEV=$(findmnt -n -o SOURCE / | sed 's/p[0-9]*$//')
NVME_DEVS=$(ls /dev/nvme*n1 2>/dev/null | grep -v "$ROOT_DEV" | sort | tr '\n' ' ' | xargs || true)
NVME_COUNT=$(echo "$NVME_DEVS" | wc -w)

DOCKER_DATA_ROOT="/var/lib/docker"

if [ "$NVME_COUNT" -gt 0 ]; then
  echo "Found $NVME_COUNT local NVMe drive(s): $NVME_DEVS"

  if [ "$NVME_COUNT" -ge 2 ]; then
    # RAID0 sobre todos los NVMe para máximo throughput y capacidad.
    # shellcheck disable=SC2086
    mdadm --create /dev/md0 --level=0 \
      --raid-devices="$NVME_COUNT" $NVME_DEVS --force
    DATA_DEV=/dev/md0
    mdadm --detail --scan >> /etc/mdadm/mdadm.conf 2>/dev/null || true
    echo "Created RAID0 array /dev/md0 over $NVME_COUNT drives"
  else
    DATA_DEV="$NVME_DEVS"
    echo "Single NVMe drive: $DATA_DEV"
  fi

  mkfs.xfs -f "$DATA_DEV"
  mkdir -p /data
  mount -o noatime "$DATA_DEV" /data

  # Persistir el mount en fstab (UUID estable incluso si los nombres de
  # dispositivo cambian entre reinicios).
  BLKID=$(blkid "$DATA_DEV" -s UUID -o value)
  echo "UUID=$BLKID /data xfs defaults,noatime 0 2" >> /etc/fstab

  # El data-root de Docker irá al NVMe: todas las imágenes, contenedores y
  # volúmenes se beneficiarán del mayor throughput local.
  mkdir -p /data/docker
  DOCKER_DATA_ROOT="/data/docker"
else
  echo "No local NVMe drives found — using EBS root for Docker storage"
fi

# ── 3. Docker ─────────────────────────────────────────────────────────────────
install -m 0755 -d /etc/apt/keyrings
if [ ! -f /etc/apt/keyrings/docker.asc ]; then
  curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
  chmod a+r /etc/apt/keyrings/docker.asc
fi

. /etc/os-release
echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] \
  https://download.docker.com/linux/ubuntu $VERSION_CODENAME stable" \
  > /etc/apt/sources.list.d/docker.list

apt-get update
apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin

# Configurar el daemon ANTES del primer arranque para que el data-root quede
# en el NVMe desde el inicio (evita migración posterior de datos).
cat > /etc/docker/daemon.json << DOCKER_DAEMON_EOF
{
  "data-root": "$DOCKER_DATA_ROOT",
  "log-driver": "json-file",
  "log-opts": {
    "max-size": "10m",
    "max-file": "3"
  }
}
DOCKER_DAEMON_EOF

systemctl enable docker
systemctl start docker
usermod -aG docker ubuntu || true

# ── 4. Tuning del kernel ───────────────────────────────────────────────────────
# File descriptor limits — necesarios para Nginx (worker_connections 16384 × 96
# workers = ~1.5 M fds) y Gunicorn (97 workers × muchas conexiones concurrentes).
cat >> /etc/security/limits.conf << 'LIMITS_EOF'
* soft nofile 1048576
* hard nofile 1048576
root soft nofile 1048576
root hard nofile 1048576
LIMITS_EOF

# Tuning de red y VM para alta concurrencia.
# vm.overcommit_memory=1 es requerido por Redis para evitar fallos de fork.
cat >> /etc/sysctl.conf << 'SYSCTL_EOF'
net.core.somaxconn = 65535
net.core.netdev_max_backlog = 65535
net.ipv4.tcp_max_syn_backlog = 65535
net.ipv4.ip_local_port_range = 1024 65535
net.ipv4.tcp_tw_reuse = 1
net.ipv4.tcp_fin_timeout = 15
fs.file-max = 2097152
vm.overcommit_memory = 1
vm.swappiness = 10
SYSCTL_EOF
sysctl -p || true

# ── 5. Repositorio ────────────────────────────────────────────────────────────
APP_DIR="/opt/${project_name}"

if [ -d "$APP_DIR/.git" ]; then
  cd "$APP_DIR"
  git fetch --all --prune
  git checkout "${repo_ref}" || git checkout -B terraform-deploy "origin/${repo_ref}"
  git pull --ff-only
else
  git clone --branch "${repo_ref}" "${repo_url}" "$APP_DIR"
  cd "$APP_DIR"
fi

# Directorio de uploads: si hay NVMe disponible, usarlo para mayor throughput
# en escrituras de vídeos/thumbnails/avatares.
if [ -d /data ]; then
  mkdir -p /data/uploads
  ln -sfn /data/uploads backend/uploads
else
  mkdir -p backend/uploads
fi

# ── 6. Archivo .env de la aplicación ─────────────────────────────────────────
# HEREDOC con marcador entre comillas simples ('APP_ENV_FILE') para que bash
# NO expanda los $${...} — en este punto ya fueron reemplazados por Terraform.
cat > .env << 'APP_ENV_FILE'
APP_ENV=${app_env}

POSTGRES_USER=${postgres_user}
POSTGRES_PASSWORD=${postgres_password}
POSTGRES_DB=${postgres_db}
DATABASE_URL=${database_url}

REDIS_PASSWORD=${redis_password}
REDIS_URL=${redis_url}

JWT_SECRET_KEY=${jwt_secret_key}
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXP_MINUTES=${jwt_access_token_exp_minutes}
AUTH_TOKEN_ISSUER_ENABLED=${auth_token_issuer_enabled}
CORS_ALLOW_ORIGINS=${cors_allow_origins}

# ── Gunicorn ──────────────────────────────────────────────────────────────────
BACKEND_WEB_CONCURRENCY=${backend_web_concurrency}
BACKEND_GUNICORN_TIMEOUT=120
BACKEND_GUNICORN_GRACEFUL_TIMEOUT=30
BACKEND_GUNICORN_KEEPALIVE=75
WORKER_CONCURRENCY=${worker_concurrency}

# ── SQLAlchemy connection pool ────────────────────────────────────────────────
# Total conexiones Postgres ≤ BACKEND_WEB_CONCURRENCY × (DB_POOL_SIZE + DB_MAX_OVERFLOW)
DB_POOL_SIZE=${db_pool_size}
DB_MAX_OVERFLOW=${db_max_overflow}
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
REDIS_MAX_CONNECTIONS=${redis_max_connections}

# ── PostgreSQL tuning ─────────────────────────────────────────────────────────
POSTGRES_MAX_CONNECTIONS=${postgres_max_connections}
POSTGRES_SHARED_BUFFERS=${postgres_shared_buffers}
POSTGRES_EFFECTIVE_CACHE_SIZE=${postgres_effective_cache_size}
POSTGRES_WORK_MEM=${postgres_work_mem}
POSTGRES_MAINTENANCE_WORK_MEM=${postgres_maintenance_work_mem}
POSTGRES_RANDOM_PAGE_COST=1.1
POSTGRES_EFFECTIVE_IO_CONCURRENCY=300
POSTGRES_SHM_SIZE=${postgres_shm_size}

# ── Redis tuning ──────────────────────────────────────────────────────────────
REDIS_MAXMEMORY=${redis_maxmemory}

# ── Docker container resource limits (c5d.24xlarge: 96 vCPU / 192 GB RAM) ────
NGINX_CPU_LIMIT=${nginx_cpu_limit}
NGINX_MEMORY_LIMIT=${nginx_memory_limit}
NGINX_CPU_RESERVATION=1.00
NGINX_MEMORY_RESERVATION=512M

POSTGRES_CPU_LIMIT=${postgres_cpu_limit}
POSTGRES_MEMORY_LIMIT=${postgres_memory_limit}
POSTGRES_CPU_RESERVATION=4.00
POSTGRES_MEMORY_RESERVATION=2G

REDIS_CPU_LIMIT=${redis_cpu_limit}
REDIS_MEMORY_LIMIT=${redis_memory_limit}
REDIS_CPU_RESERVATION=1.00
REDIS_MEMORY_RESERVATION=512M

BACKEND_CPU_LIMIT=${backend_cpu_limit}
BACKEND_MEMORY_LIMIT=${backend_memory_limit}
BACKEND_CPU_RESERVATION=4.00
BACKEND_MEMORY_RESERVATION=2G

WORKER_CPU_LIMIT=${worker_cpu_limit}
WORKER_MEMORY_LIMIT=${worker_memory_limit}
WORKER_CPU_RESERVATION=2.00
WORKER_MEMORY_RESERVATION=1G

FRONTEND_CPU_LIMIT=${frontend_cpu_limit}
FRONTEND_MEMORY_LIMIT=${frontend_memory_limit}
FRONTEND_CPU_RESERVATION=0.25
FRONTEND_MEMORY_RESERVATION=128M
APP_ENV_FILE

chown -R ubuntu:ubuntu "$APP_DIR"

# ── 7. Compose stack ──────────────────────────────────────────────────────────
docker compose --profile prod up -d
docker compose --profile prod ps

echo "=== bootstrap finished at $(date -u) ==="

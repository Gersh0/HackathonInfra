# =============================================================================
# APPLICATION SECRETS & CONFIGURATION
# =============================================================================
# Copy to .env and fill in your values. Never commit .env.
#
# Configuration is split into two layers:
#
#   1. This file — credentials and deployment-specific settings (set manually)
#
#   2. --hw tiny|small|medium|large — worker counts, memory limits, connection
#      pool sizes, and all PostgreSQL/Redis tuning parameters.
#      These are managed by the deploy script from infra/envs/hw-<tier>.env.
#      DO NOT set them here; they override anything in .env at deploy time.
#
# See: docs/04-environment-variables.md
#      docs/12-hardware-profiles.md
# =============================================================================

# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=production

# ── PostgreSQL credentials ───────────────────────────────────────────────────
POSTGRES_USER=your_db_username
POSTGRES_PASSWORD=StrongPassword12!
POSTGRES_DB=youtube_clone

# Leave blank — built automatically from POSTGRES_* at container start.
# Set only when running the backend outside Docker or when the password
# contains URL-reserved characters (e.g. postgresql+psycopg://user:pass@host/db).
DATABASE_URL=

# ── Redis ────────────────────────────────────────────────────────────────────
# Leave blank for no auth (dev only). Always set in production.
REDIS_PASSWORD=

# Leave blank — built automatically from REDIS_PASSWORD.
REDIS_URL=

# ── JWT Authentication ───────────────────────────────────────────────────────
# REQUIRED. Must be at least 32 characters, randomly generated.
# Generate: openssl rand -base64 48
#       or: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=REPLACE_WITH_STRONG_SECRET_MIN_32_CHARS
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXP_MINUTES=120
# Set to true to allow the frontend to issue JWT tokens via POST /auth/token.
# Required for the app's simplified auth model (no OAuth provider configured).
AUTH_TOKEN_ISSUER_ENABLED=true

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# Add your production domain when deploying to AWS (e.g. https://yourdomain.com).
CORS_ALLOW_ORIGINS=http://localhost,http://localhost:5173,http://127.0.0.1

# ── Gunicorn timeouts ────────────────────────────────────────────────────────
# Worker count (BACKEND_WEB_CONCURRENCY) is controlled by --hw, not here.
BACKEND_GUNICORN_TIMEOUT=120
BACKEND_GUNICORN_GRACEFUL_TIMEOUT=30
BACKEND_GUNICORN_KEEPALIVE=75

# ── Observability stack (--profile observe) ───────────────────────────────────
# Used by Grafana when running docker compose --profile observe.
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_ROOT_URL=http://localhost/grafana
